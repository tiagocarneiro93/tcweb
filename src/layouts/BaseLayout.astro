---
import '../styles/global.css';
import SiteHeader from '../components/navigation/SiteHeader.astro';
import SiteFooter from '../components/navigation/SiteFooter.astro';
import CookieConsent from '../components/shared/CookieConsent.astro';
import { withBase } from '../lib/url';
import { routes, localePath, type RouteKey, type Lang } from '../lib/routes';

interface Props {
  title: string;
  description: string;
  /** Which page this is, so canonical/hreflang/the language switcher can look up its slug in every language. */
  page?: RouteKey;
  /** Path under public/ for the social-share image. */
  image?: string;
  lang?: Lang;
  /** For utility pages (404...) that shouldn't be indexed or listed as a hreflang alternate. */
  noindex?: boolean;
}
const { title, description, page = 'home', image = 'og-image.png', lang = 'pt', noindex = false } = Astro.props;

const altLang: Lang = lang === 'en' ? 'pt' : 'en';
const canonicalURL = new URL(withBase(localePath(lang, routes[page][lang])), Astro.site);
const alternateURL = new URL(withBase(localePath(altLang, routes[page][altLang])), Astro.site);
const imageURL = new URL(withBase(image), Astro.site);

const htmlLang = lang === 'en' ? 'en' : 'pt-PT';
const ogLocale = lang === 'en' ? 'en_US' : 'pt_PT';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'TCWeb',
  url: Astro.site ? new URL(withBase(''), Astro.site).href : undefined,
  description:
    lang === 'en'
      ? 'Websites, systems and consulting for businesses that won’t settle for generic.'
      : 'Websites, sistemas e consultoria para empresas que não aceitam o genérico.',
  slogan: lang === 'en' ? 'Digital presence, tailored.' : 'Presença digital à medida.',
  areaServed: 'PT',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Lousado',
    addressRegion: 'Vila Nova de Famalicão',
    addressCountry: 'PT',
  },
  founder: {
    '@type': 'Person',
    name: 'Tiago Carneiro',
  },
};
---
<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase('apple-touch-icon.svg')} />
    <link rel="manifest" href={withBase('site.webmanifest')} />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <Fragment>
        <link rel="canonical" href={canonicalURL} />
        <link rel="alternate" hreflang={lang === 'en' ? 'en' : 'pt-PT'} href={canonicalURL} />
        <link rel="alternate" hreflang={altLang === 'en' ? 'en' : 'pt-PT'} href={alternateURL} />
        <link rel="alternate" hreflang="x-default" href={lang === 'pt' ? canonicalURL : alternateURL} />
      </Fragment>
    )}
    <meta name="theme-color" content="#14161A" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="TCWeb" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} is:inline />
  </head>
  <body>
    <SiteHeader lang={lang} altHref={alternateURL.pathname} />
    <slot />
    <SiteFooter lang={lang} />
    <CookieConsent lang={lang} />
  </body>
</html>
