---
import '../styles/global.css';
import SiteHeader from '../components/navigation/SiteHeader.astro';
import SiteFooter from '../components/navigation/SiteFooter.astro';
import CookieConsent from '../components/shared/CookieConsent.astro';
import { withBase } from '../lib/url';

interface Props {
  title: string;
  description: string;
  /** Route path relative to the site root, no leading/trailing slash (e.g. "" for home, "servicos" for a future page). */
  path?: string;
  /** Path under public/ for the social-share image. */
  image?: string;
}
const { title, description, path = '', image = 'og-image.png' } = Astro.props;

const canonicalURL = new URL(withBase(path), Astro.site);
const imageURL = new URL(withBase(image), Astro.site);

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'TCWeb',
  url: Astro.site ? new URL(withBase(''), Astro.site).href : undefined,
  description: 'Websites, sistemas e consultoria para empresas que não aceitam o genérico.',
  slogan: 'Presença digital à medida.',
  areaServed: 'PT',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Lousado',
    addressRegion: 'Vila Nova de Famalicão',
    addressCountry: 'PT',
  },
  founder: {
    '@type': 'Person',
    name: 'Tiago Carneiro',
  },
};
---
<!doctype html>
<html lang="pt-PT">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase('apple-touch-icon.svg')} />
    <link rel="manifest" href={withBase('site.webmanifest')} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="theme-color" content="#14161A" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="TCWeb" />
    <meta property="og:locale" content="pt_PT" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} is:inline />
  </head>
  <body>
    <SiteHeader />
    <slot />
    <SiteFooter />
    <CookieConsent />
  </body>
</html>
