---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/core/Section.astro';
import AccentRule from '../components/core/AccentRule.astro';
import Label from '../components/core/Label.astro';
import Button from '../components/core/Button.astro';
import Card from '../components/content/Card.astro';
import Stat from '../components/content/Stat.astro';
import Quote from '../components/content/Quote.astro';
import Tag from '../components/content/Tag.astro';
import SectionHead from '../components/shared/SectionHead.astro';
import ImageSlot from '../components/shared/ImageSlot.astro';
import { withBase } from '../lib/url';

// Placeholder case studies — replace with real client work before launch.
const projects = [
  { eyebrow: 'Imobiliário', title: 'Quinta do Vale', tags: ['Identidade', 'Website', 'SEO'], width: 420 },
  { eyebrow: 'Retalho', title: 'Casa Alvarinho', tags: ['Loja online', 'Integrações'], width: 340 },
  { eyebrow: 'Serviços', title: 'Clínica Norte', tags: ['Website', 'Marcações'], width: 340 },
];
---
<BaseLayout
  title="TCWeb · Presença digital à medida"
  description="Websites, sistemas e consultoria para empresas que não aceitam o genérico. TCWeb é a prática de Tiago Carneiro, em Lousado, Vila Nova de Famalicão."
>
  <main>
    <!-- Hero: asymmetric, image bleeds to the viewport edge -->
    <section class="tc-hero-a">
      <div class="tc-hero-a__row">
        <div class="tc-hero-a__copy">
          <h1 class="tc-display">Presença digital à medida para marcas exigentes.</h1>
          <p class="tc-hero-a__intro">Websites, sistemas e consultoria para empresas que não aceitam o genérico.</p>
          <div class="tc-hero__actions">
            <Button href={withBase('contacto')}>Marcar conversa</Button>
            <Button href={withBase('projetos')} variant="quiet">Ver projetos</Button>
          </div>
        </div>
        <div class="tc-hero-a__media">
          <ImageSlot caption="Fotografia — fachada de projeto recente" class="tc-hero-a__media-main" />
          <ImageSlot caption="Detalhe de interior" class="tc-hero-a__media-detail" />
        </div>
      </div>
    </section>

    <!-- Services: one featured card (with image) beside two stacked ones -->
    <Section tone="canvas">
      <SectionHead label="Serviços" title="O que fazemos" intro="Três frentes de trabalho, uma só forma de trabalhar: com método e atenção ao detalhe." />
      <div class="tc-services-a">
        <div class="tc-card tc-services-a__featured">
          <div>
            <span class="tc-card__index">01</span>
            <h3 class="tc-card__title">Websites</h3>
            <p class="tc-card__body">Sites institucionais e portefólios desenhados ao pormenor, rápidos e acessíveis.</p>
          </div>
          <ImageSlot caption="Fotografia — website em ecrã" class="tc-services-a__image" />
        </div>
        <Card index={2} title="Sistemas">Integrações, automações e manutenção dos sistemas que a sua empresa já usa.</Card>
        <Card index={3} title="Consultoria">Quinze anos de experiência ao serviço das suas decisões técnicas.</Card>
      </div>
    </Section>

    <!-- Stats: overlaid on a full-bleed photo band -->
    <section class="tc-dark tc-stats-photo">
      <ImageSlot tone="ink" caption="Fotografia — mesa de trabalho" class="tc-stats-photo__bg" />
      <div class="tc-stats-photo__scrim"></div>
      <div class="tc-container tc-stats-photo__content">
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:var(--tc-space-4)">
          <Stat value="15" label="Anos de experiência" />
          <Stat value="100/100" label="Lighthouse" />
          <Stat value="<24h" label="Tempo de resposta" />
          <Stat value="PT" label="Famalicão, Portugal" />
        </div>
      </div>
    </section>

    <!-- Projects: horizontal scroll-style gallery -->
    <Section tone="canvas">
      <SectionHead label="Projetos selecionados" title="Trabalho recente" />
      <div class="tc-gallery">
        {projects.map((p) => (
          <a href={withBase('projetos')} class="tc-project-card tc-gallery__item" style={`width:clamp(240px, 80vw, ${p.width}px)`}>
            <ImageSlot caption={p.title} />
            <div class="tc-project-card__meta">
              <Label>{p.eyebrow}</Label>
              <h3 class="tc-project-card__title">{p.title}</h3>
              <div class="tc-project-card__tags">
                {p.tags.map((t) => <Tag>{t}</Tag>)}
              </div>
            </div>
          </a>
        ))}
      </div>
      <div style="margin-top:var(--tc-space-5)">
        <Button href={withBase('projetos')} variant="quiet">Ver todos os projetos</Button>
      </div>
    </Section>

    <Section tone="ink">
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:var(--tc-space-6);align-items:start">
        <Quote author="Ana Ribeiro" role="Diretora, Vale Imobiliária">Percebeu a marca antes de escrever uma linha de código.</Quote>
        <div>
          <AccentRule />
          <Label>Sobre</Label>
          <p style="margin-top:var(--tc-space-2)">TCWeb é a prática de Tiago Carneiro, desenvolvedor web e consultor de software, com quinze anos de experiência, em Lousado, Vila Nova de Famalicão.</p>
          <Button href={withBase('sobre')} style="margin-top:var(--tc-space-3)">Conhecer o TCWeb</Button>
        </div>
      </div>
    </Section>
  </main>
</BaseLayout>
