---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/core/Section.astro';
import Button from '../components/core/Button.astro';
import Label from '../components/core/Label.astro';
import AccentRule from '../components/core/AccentRule.astro';
import { withBase } from '../lib/url';
---
<BaseLayout
  title="Página não encontrada / Page not found · TCWeb"
  description="A página que procura não existe ou foi movida. The page you're looking for doesn't exist or has moved."
  noindex
>
  <main>
    <Section tone="canvas">
      <div class="tc-404">
        <Label pill>404</Label>
        <h1 class="tc-display tc-404__title">Página não encontrada.</h1>
        <p class="tc-404__body">A página que procura não existe ou foi movida.</p>
        <div class="tc-hero__actions tc-404__actions">
          <Button href={withBase('')}>Voltar ao início</Button>
        </div>

        <AccentRule align="center" class="tc-404__rule" />

        <h2 class="tc-404__title-en">Page not found.</h2>
        <p class="tc-404__body">The page you're looking for doesn't exist or has moved.</p>
        <div class="tc-hero__actions tc-404__actions">
          <Button href={withBase('en/')} variant="outline">Back to homepage</Button>
        </div>
      </div>
    </Section>
  </main>
</BaseLayout>
