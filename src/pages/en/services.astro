---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/shared/Hero.astro';
import Section from '../../components/core/Section.astro';
import SectionHead from '../../components/shared/SectionHead.astro';
import Label from '../../components/core/Label.astro';
import Button from '../../components/core/Button.astro';
import { withBase } from '../../lib/url';
import { routes, localePath } from '../../lib/routes';

const contactHref = withBase(localePath('en', routes.contact.en));

const services = [
  {
    id: 'websites',
    index: '01',
    title: 'Websites',
    intro: 'Institutional sites, portfolios and simple online stores, designed down to the last detail — fast and accessible.',
    items: [
      'Custom design, aligned with your brand identity',
      'Fast, accessible, responsive development',
      'Search engine optimization (SEO) from day one',
      'Hosting, domain and security certificate set up for you',
    ],
  },
  {
    id: 'systems',
    index: '02',
    title: 'Systems',
    intro: 'Integrations, automation and maintenance for the systems your business already uses.',
    items: [
      'Integration between platforms (CRM, invoicing, marketing)',
      'Automation of repetitive tasks',
      'Ongoing maintenance and monitoring',
      'Migration and modernization of legacy systems',
    ],
  },
  {
    id: 'consulting',
    index: '03',
    title: 'Consulting',
    intro: 'Fifteen years of experience behind your technical decisions.',
    items: [
      'Technical and performance audits',
      'Stack and architecture choices',
      'Oversight of teams and vendors',
      'Training and knowledge transfer',
    ],
  },
];

const steps = [
  { step: '01', title: 'Conversation', body: 'A first, no-obligation conversation to understand the project, the goals and the business context.' },
  { step: '02', title: 'Proposal', body: 'A clear proposal with scope, timeline and investment — no fine print.' },
  { step: '03', title: 'Design & development', body: 'Design and development in short cycles, with constant feedback throughout.' },
  { step: '04', title: 'Launch & support', body: 'A guided launch and ongoing support once you’re live.' },
];
---
<BaseLayout
  title="Services · TCWeb"
  description="Websites, systems and consulting: three lines of work, one way of working, with method and attention to detail."
  page="services"
  lang="en"
>
  <main>
    <Hero
      label="Services"
      title="Websites, systems and consulting."
      intro="Three lines of work, one way of working: with method and attention to detail."
      cta="Book a call"
      ctaHref={contactHref}
    />

    {services.map((s, i) => (
      <Section tone={i % 2 === 0 ? 'canvas' : 'canvas-alt'} id={s.id}>
        <div class="tc-service-block">
          <div>
            <span class="tc-card__index">{s.index}</span>
            <h2>{s.title}</h2>
            <p style="margin-top:var(--tc-space-2);max-width:40ch">{s.intro}</p>
          </div>
          <ul class="tc-service-block__list">
            {s.items.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </Section>
    ))}

    <Section tone="canvas">
      <SectionHead label="How it works" title="A four-step process" />
      <div class="tc-accordion">
        {steps.map((s, i) => (
          <details class="tc-accordion-item" open={i === 0}>
            <summary><span><span class="tc-accordion-item__step">{s.step}</span>{s.title}</span></summary>
            <p class="tc-accordion-item__body">{s.body}</p>
          </details>
        ))}
      </div>
    </Section>

    <Section tone="ink">
      <div style="text-align:center;max-width:40ch;margin-inline:auto">
        <Label pill>Let's talk</Label>
        <h2 style="margin-top:var(--tc-space-3)">Have a project in mind?</h2>
        <Button href={contactHref} style="margin-top:var(--tc-space-4)">Book a call</Button>
      </div>
    </Section>
  </main>
</BaseLayout>
