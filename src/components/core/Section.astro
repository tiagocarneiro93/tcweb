---
interface Props {
  tone?: 'canvas' | 'canvas-alt' | 'ink';
  padding?: 'normal' | 'tight' | 'flush';
  class?: string;
}
const { tone = 'canvas', padding = 'normal', class: className = '' } = Astro.props;
const paddingClass = padding === 'tight' ? 'tc-section--tight' : padding === 'flush' ? 'tc-section--flush' : '';
---
<section class:list={['tc-section', paddingClass, tone === 'ink' ? 'tc-dark' : `tc-section--${tone}`, className]}>
  <div class="tc-container">
    <slot />
  </div>
</section>
