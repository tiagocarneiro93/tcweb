---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'section'> {
  tone?: 'canvas' | 'canvas-alt' | 'ink';
  padding?: 'normal' | 'tight' | 'flush';
}
const { tone = 'canvas', padding = 'normal', class: className = '', ...rest } = Astro.props;
const paddingClass = padding === 'tight' ? 'tc-section--tight' : padding === 'flush' ? 'tc-section--flush' : '';
---
<section class:list={['tc-section', paddingClass, tone === 'ink' ? 'tc-dark' : `tc-section--${tone}`, className]} {...rest}>
  <div class="tc-container">
    <slot />
  </div>
</section>
