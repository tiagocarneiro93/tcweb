---
import Logo from '../core/Logo.astro';
import NavLink from './NavLink.astro';
import Button from '../core/Button.astro';
import { withBase } from '../../lib/url';
import { routes, anchors, localePath, type Lang } from '../../lib/routes';
import { t } from '../../i18n/ui';

interface Props {
  lang?: Lang;
  /** Path (with base already applied) to the equivalent page in the other language. */
  altHref?: string;
}
const { lang = 'pt', altHref } = Astro.props;
const ui = t(lang);

const homeHref = withBase(localePath(lang, routes.home[lang]));

// Projetos/Projects and Sobre/About don't have enough real content yet for
// standalone pages, so they point at the teaser sections on the home page.
const items = [
  { label: ui.nav.services, href: withBase(localePath(lang, routes.services[lang])) },
  { label: ui.nav.projects, href: `${homeHref}#${anchors.projects[lang]}` },
  { label: ui.nav.about, href: `${homeHref}#${anchors.about[lang]}` },
];

const currentPath = Astro.url.pathname;
const toggleLabel = lang === 'en' ? 'Open navigation menu' : 'Abrir menu de navegação';
---
<header class="tc-header">
  <div class="tc-header__bar">
    <a href={homeHref} style="display:block">
      <Logo variant="short" tone="ink" height={26} />
    </a>
    <input type="checkbox" id="nav-toggle" class="tc-header__toggle-input" />
    <label for="nav-toggle" class="tc-header__toggle" aria-label={toggleLabel}>
      <span></span><span></span><span></span>
    </label>
    <nav class="tc-header__nav" id="site-nav">
      {items.map((it) => (
        <NavLink href={it.href} active={currentPath === it.href}>{it.label}</NavLink>
      ))}
      {altHref && (
        <a href={altHref} class="tc-nav-link tc-header__lang" hreflang={lang === 'en' ? 'pt-PT' : 'en'}>{ui.nav.switchTo}</a>
      )}
      <Button href={withBase(localePath(lang, routes.contact[lang]))} size="sm">{ui.nav.cta}</Button>
    </nav>
  </div>
</header>

<script is:inline>
  // Progressive enhancement only — the menu itself is a pure CSS
  // checkbox toggle and works with this script disabled. This just
  // closes it after a same-page anchor link, which a checkbox alone
  // can't do since anchor navigation doesn't reload the page.
  document.querySelectorAll('#site-nav a').forEach((link) => {
    link.addEventListener('click', () => {
      const toggle = document.getElementById('nav-toggle');
      if (toggle) toggle.checked = false;
    });
  });
</script>
