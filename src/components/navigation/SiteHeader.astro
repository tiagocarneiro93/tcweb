---
import Logo from '../core/Logo.astro';
import NavLink from './NavLink.astro';
import Button from '../core/Button.astro';
import { withBase } from '../../lib/url';

// Projetos and Sobre don't have enough real content yet for standalone
// pages, so they point at the teaser sections on the home page instead.
const items = [
  { label: 'Serviços', href: withBase('servicos') },
  { label: 'Projetos', href: `${withBase('')}#projetos` },
  { label: 'Sobre', href: `${withBase('')}#sobre` },
];

const currentPath = Astro.url.pathname;
---
<header class="tc-header">
  <div class="tc-header__bar">
    <a href={withBase('')} style="display:block">
      <Logo variant="short" tone="ink" height={26} />
    </a>
    <input type="checkbox" id="nav-toggle" class="tc-header__toggle-input" />
    <label for="nav-toggle" class="tc-header__toggle" aria-label="Abrir menu de navegação">
      <span></span><span></span><span></span>
    </label>
    <nav class="tc-header__nav" id="site-nav">
      {items.map((it) => (
        <NavLink href={it.href} active={currentPath === it.href}>{it.label}</NavLink>
      ))}
      <Button href={withBase('contacto')} size="sm">Marcar conversa</Button>
    </nav>
  </div>
</header>

<script is:inline>
  // Progressive enhancement only — the menu itself is a pure CSS
  // checkbox toggle and works with this script disabled. This just
  // closes it after a same-page anchor link, which a checkbox alone
  // can't do since anchor navigation doesn't reload the page.
  document.querySelectorAll('#site-nav a').forEach((link) => {
    link.addEventListener('click', () => {
      const toggle = document.getElementById('nav-toggle');
      if (toggle) toggle.checked = false;
    });
  });
</script>
