---
import Logo from '../core/Logo.astro';
import Label from '../core/Label.astro';
import { withBase } from '../../lib/url';

const columns = [
  {
    title: 'Serviços',
    links: [
      { label: 'Websites', href: `${withBase('servicos')}#websites` },
      { label: 'Sistemas', href: `${withBase('servicos')}#sistemas` },
      { label: 'Consultoria', href: `${withBase('servicos')}#consultoria` },
    ],
  },
  {
    title: 'Empresa',
    links: [
      { label: 'Projetos', href: `${withBase('')}#projetos` },
      { label: 'Sobre', href: `${withBase('')}#sobre` },
    ],
  },
];
---
<footer class="tc-footer tc-dark">
  <div class="tc-footer__inner">
    <div class="tc-footer__grid">
      <div>
        <Logo variant="stacked" tone="canvas" height={72} />
        <p class="tc-footer__tagline">Presença digital à medida.</p>
      </div>
      {columns.map((col) => (
        <div>
          <Label as="div" class="tc-footer__col-title">{col.title}</Label>
          <ul class="tc-footer__links">
            {col.links.map((l) => (
              <li><a href={l.href}>{l.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
      <div>
        <Label as="div" class="tc-footer__col-title">Contacto</Label>
        <div class="tc-footer__contact">
          <a href="mailto:[EMAIL]">[EMAIL]</a>
          <span>[TELEFONE]</span>
          <span>Lousado · Vila Nova de Famalicão</span>
        </div>
      </div>
    </div>
    <div class="tc-footer__legal">
      <span>© {new Date().getFullYear()} TCWeb · Tiago Carneiro</span>
      <div class="tc-footer__legal-links">
        <a href={withBase('politica-de-cookies')}>Política de cookies</a>
        <button type="button" data-cookie-settings>Preferências de cookies</button>
      </div>
      <span>NIF [NIF]</span>
    </div>
  </div>
</footer>
