---
import Logo from '../core/Logo.astro';
import Label from '../core/Label.astro';
import { withBase } from '../../lib/url';
import { routes, anchors, localePath, type Lang } from '../../lib/routes';
import { t } from '../../i18n/ui';

interface Props {
  lang?: Lang;
}
const { lang = 'pt' } = Astro.props;
const ui = t(lang);

const homeHref = withBase(localePath(lang, routes.home[lang]));
const servicesHref = withBase(localePath(lang, routes.services[lang]));

const columns = [
  {
    title: ui.footer.servicesCol,
    links: [
      { label: ui.footer.websites, href: `${servicesHref}#websites` },
      { label: ui.footer.systems, href: `${servicesHref}#${lang === 'en' ? 'systems' : 'sistemas'}` },
      { label: ui.footer.consulting, href: `${servicesHref}#${lang === 'en' ? 'consulting' : 'consultoria'}` },
    ],
  },
  {
    title: ui.footer.companyCol,
    links: [
      { label: ui.footer.projects, href: `${homeHref}#${anchors.projects[lang]}` },
      { label: ui.footer.about, href: `${homeHref}#${anchors.about[lang]}` },
    ],
  },
];
---
<footer class="tc-footer tc-dark">
  <div class="tc-footer__inner">
    <div class="tc-footer__grid">
      <div>
        <Logo variant="stacked" tone="canvas" height={72} />
        <p class="tc-footer__tagline">{ui.footer.tagline}</p>
      </div>
      {columns.map((col) => (
        <div>
          <Label as="div" class="tc-footer__col-title">{col.title}</Label>
          <ul class="tc-footer__links">
            {col.links.map((l) => (
              <li><a href={l.href}>{l.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
      <div>
        <Label as="div" class="tc-footer__col-title">{ui.footer.contactCol}</Label>
        <div class="tc-footer__contact">
          <a href="mailto:[EMAIL]">[EMAIL]</a>
          <span>[TELEFONE]</span>
          <span>Lousado · Vila Nova de Famalicão</span>
        </div>
      </div>
    </div>
    <div class="tc-footer__legal">
      <span>© {new Date().getFullYear()} TCWeb · Tiago Carneiro</span>
      <div class="tc-footer__legal-links">
        <a href={withBase(localePath(lang, routes.privacy[lang]))}>{ui.footer.privacyPolicy}</a>
        <a href={withBase(localePath(lang, routes.cookies[lang]))}>{ui.footer.cookiePolicy}</a>
        <button type="button" data-cookie-settings>{ui.footer.cookieSettings}</button>
      </div>
      <span>{ui.footer.nif} [NIF]</span>
    </div>
  </div>
</footer>
